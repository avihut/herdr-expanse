{
  "id": "root",
  "type": "column",
  "background": "canvas",
  "theme": {
    "dark": "expanse-dark",
    "light": "expanse-light"
  },
  "font": "Geist Mono",
  "font_size": 15,
  "ui_font": "Geist Mono",
  "terminal_padding": [
    8,
    8
  ],
  "terminal_opacity": 1,
  "titlebar": "none",
  "traffic_lights": [
    16,
    14
  ],
  "terminal_menu": "expanse",
  "preview": "layouts/expanse.svg",
  "children": [
    {
      "id": "expanse-top",
      "type": "block",
      "content": {
        "mod": "expanse",
        "props": {
          "role": "top"
        }
      },
      "size": {
        "px": 73
      },
      "window_drag": true
    },
    {
      "id": "expanse-body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "block",
          "content": {
            "mod": "expanse",
            "props": {
              "role": "sidebar"
            }
          },
          "size": {
            "px": 280
          },
          "min": 220,
          "max": 440
        },
        {
          "id": "expanse-work",
          "type": "column",
          "children": [
            {
              "id": "expanse-tabs",
              "type": "block",
              "content": {
                "mod": "expanse",
                "props": {
                  "role": "tabs"
                }
              },
              "size": {
                "px": 38
              }
            },
            {
              "id": "expanse-terminals",
              "type": "block",
              "padding": 6,
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "expanse",
                      "props": {
                        "role": "pane"
                      }
                    },
                    "height": 28,
                    "reveal": "always",
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 2,
                    "color": "accent"
                  },
                  "gap": 6,
                  "radius": 2,
                  "lone": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "expanse-footer",
      "type": "block",
      "content": {
        "mod": "expanse",
        "props": {
          "role": "footer"
        }
      },
      "size": {
        "px": 29
      }
    }
  ]
}
